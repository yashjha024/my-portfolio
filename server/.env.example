# Server Configuration
PORT=5000
NODE_ENV=development
# Public site origin (scheme://host, no path). In production this must be the https domain that serves
# the SPA, because the browser calls /api on that same origin through the Vercel rewrite.
CLIENT_URL=http://localhost:5173
# Canonical public site origin for sitemap/RSS links (no path). Must match the client VITE_SITE_URL.
# Defaults to https://yashjha.vercel.app until a custom domain is confirmed.
SITE_URL=https://yashjha.vercel.app
# Optional extra exact origins allowed for credentialed CORS (comma-separated; no wildcards, no paths).
# Leave empty in production unless a specific separate origin must call the API.
ALLOWED_ORIGINS=
# Reverse-proxy hops in front of the API whose X-Forwarded-For entries Express may trust (integer 0-5).
# 0 = trust none (local development). Expected chain in production: browser -> Vercel /api rewrite ->
# Railway edge -> app, i.e. 2 hops. Confirm in staging before relying on it.
TRUST_PROXY_HOPS=0

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Server secret key (sb_secret_…) from Supabase -> Project Settings -> API Keys. Never a publishable key.
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy name, still read as a fallback during key rotation; remove once SUPABASE_SECRET_KEY is set.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Draft preview token signing secret (required, 32+ chars, when NODE_ENV=production)
JWT_SECRET=generate_a_random_value_of_at_least_32_characters

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Owner & Contact Email
OWNER_EMAIL=yashjha024@gmail.com

# Email Provider Configuration (Transactional Contact Inquiries & Notifications)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=notifications@yourdomain.com
CONTACT_EMAIL=yashjha024@gmail.com
