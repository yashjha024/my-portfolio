# ==============================================================================
# PRODUCT MANAGEMENT PORTFOLIO MONOREPO ENVIRONMENT VARIABLES
# Copy server/.env.example -> server/.env and client/.env.example -> client/.env
# ==============================================================================

# Server Configuration (server/.env)
PORT=5000
NODE_ENV=development
# Public site origin (scheme://host, no path). In production this must be the https domain that serves
# the SPA, because the browser calls /api on that same origin through the Vercel rewrite.
CLIENT_URL=http://localhost:5173
# Canonical public site origin for sitemap/RSS links (no path). Must match the client VITE_SITE_URL.
# Defaults to https://yashjha.vercel.app until a custom domain is confirmed.
SITE_URL=https://yashjha.vercel.app
# Optional extra exact origins allowed for credentialed CORS (comma-separated; no wildcards, no paths).
# Leave empty in production unless a specific separate origin must call the API.
ALLOWED_ORIGINS=
# Reverse-proxy hops in front of the API whose X-Forwarded-For entries Express may trust (integer 0-5).
# 0 = trust none (local development). Expected chain in production: browser -> Vercel /api rewrite ->
# Railway edge -> app, i.e. 2 hops. Confirm in staging before relying on it.
TRUST_PROXY_HOPS=0
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Signs draft preview tokens; required (32+ chars) when NODE_ENV=production
JWT_SECRET=generate_a_random_value_of_at_least_32_characters
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
OWNER_EMAIL=yashjha024@gmail.com
RESEND_API_KEY=your_resend_api_key

# Client Configuration (client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
