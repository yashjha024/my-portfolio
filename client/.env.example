# Canonical public site origin (no path). Used for canonical/Open Graph URLs, JSON-LD and
# robots.txt. Must match the server's SITE_URL. Defaults to https://yashjha.vercel.app.
VITE_SITE_URL=https://yashjha.vercel.app

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Supabase Client Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
